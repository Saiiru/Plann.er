{
    "name": "planner-api",
    "version": "1.0.0",
    "scripts": {
        "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate deploy",
        "setup": "npm run db:generate && npm run db:migrate",
        "typecheck": "tsc --noEmit",
        "build": "tsc -p tsconfig.build.json",
        "start": "node --env-file-if-exists=.env scripts/start.cjs",
        "test": "tsx --test tests/*.test.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "API educacional de planejamento de viagens — NLW Journey",
    "devDependencies": {
        "@types/node": "^22.3.0",
        "prisma": "5.18.0",
        "tsx": "^4.17.0",
        "typescript": "^5.5.4"
    },
    "dependencies": {
        "@fastify/cors": "^11.4.1",
        "@prisma/client": "5.18.0",
        "dayjs": "^1.11.12",
        "fastify": "^5.12.8",
        "fastify-type-provider-zod": "^7.0.0",
        "zod": "^4.6.7"
    },
    "engines": {
        "node": ">=22.9"
    }
}
